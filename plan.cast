[4.645368, "o", "\u001b[?25l\u001b[3D\u001b[4B\r\u001b[2A\u001b[38;5;153m/kestra-plugin-qa                    Build, deploy, and browser-test a Kestra plugin end-to-end. Use when the user asks to QA, test, or validate a plugin, issue,\u001b[39m\u001b[K\r\u001b[2C\u001b[1B                                   \u001b[38;5;153mor branch. (project)\u001b[39m\r\r\n\u001b[38;5;246m/kestra-plugin-manage-issues\u001b[38GCreate\u001b[45Gor\u001b[48Gupdate\u001b[55GKestra\u001b[62Gplugin\u001b[69GGitHub\u001b[76Gissues\u001b[83G—\u001b[85Gnew\u001b[89Gfeatures,\u001b[99Gbug\u001b[103Gfixes,\u001b[110Gor\u001b[113Greformatting\u001b[126Gof\u001b[129Gexisting\u001b[138Gissues.\u001b[146GAsks\u001b[151Gwhether\u001b[159Gto\u001b[39m\r\r\n\u001b[38G\u001b[38;5;246mcreate\u001b[45Gor\u001b[48Gupdate,\u001b[56Gthen\u001b[61Gwhether\u001b[69Gthe\u001b[73Gitem\u001b[78Gis\u001b[81Ga\u001b[83Gfeature\u001b[91Gor\u001b[94Ga\u001b[96Gfix.\u001b[101G(project)\u001b[39m\r\r\n\u001b[38;5;246m/kestra-plugin-plan\u001b[38GRead\u001b[43Ga\u001b[45GGitHub\u001b[52Gissue,\u001b[59Ggenerate\u001b[68Ga\u001b[70Gstructured\u001b[81Gimplementation\u001b[96Gplan,\u001b[102Gand\u001b[106Gpost\u001b[111Git\u001b[114Gas\u001b[117Ga\u001b[119Gcomment.\u001b[128GHuman\u001b[134Gmust\u001b[139Gthen\u001b[144Gcomment\u001b[39m\r\r\n\u001b[38G\u001b[38;5;246m/plan-approved\u001b[53Gbefore\u001b[60Gimplementation\u001b[75Gcan\u001b[79Gbegin.\u001b[86G(project)\u001b[39m\r\r\n\u001b[38;5;246m/kestra-plugin-issue\u001b[38GExecute\u001b[46Gfull\u001b[51Gend-to-end\u001b[62Gimplementation\u001b[77Gof\u001b[80Ga\u001b[82GKestra\u001b[89Gplugin\u001b[96GGitHub\u001b[103Gissue.\u001b[110GRequires\u001b[119G/plan-approved\u001b[134Gcomment\u001b[142Gto\u001b[145Gexist.\u001b[152GOrchestrates\u001b[39m\r\r\n\u001b[38G\u001b[38;5;246mdeveloper\u001b[48G+\u001b[50Greviewer\u001b[59G+\u001b[61GQA\u001b[64G+\u001b[66Gdocs\u001b[71Gdirectly.\u001b[81G(project)\u001b[39m\r\r\n\u001b[38;5;246m/ci-rca\u001b[38GTriage\u001b[45GGitHub\u001b[52GActions\u001b[60Gbackend\u001b[68Gtest\u001b[73Gfailures\u001b[82Gon\u001b[85Ga\u001b[87Gbranch.\u001b[95GGathers\u001b[103Gfailing\u001b[111Gruns,\u001b[117Gfetches\u001b[125Gtest\u001b[130Gfailure\u001b[138Glogs,\u001b[144Gclassifies\u001b[155Gtests\u001b[161Gas\u001b[39m\r\r\n\u001b[38G\u001b[38;5;246mconsistent\u001b[49Gvs\u001b[52Gflaky\u001b[58Gacross\u001b[65Gthe\u001b[69Glast\u001b[74GN\u001b[76Gruns,\u001b[82Gand\u001b[86Goutputs\u001b[94Ga\u001b[96Gstructured\u001b[107Greport.\u001b[115GUse\u001b[119Gwhenever\u001b[128Gthe\u001b[132Guser\u001b[137Gasks\u001b[142G\"RCA\u001b[147GCI\",\u001b[152G\"why\u001b[157Gis\u001b[160Gdev…\u001b[39m\r\r\n\u001b[38;5;246m/add-dir\u001b[38GAdd\u001b[42Ga\u001b[44Gnew\u001b[48Gworking\u001b[56Gdirectory\u001b[39m\r\r\n\u001b[38;5;246m/advisor\u001b[38GLet\u001b[42GClaude\u001b[49Gconsult\u001b[57Ga\u001b[59Gstronger\u001b[68Gmodel\u001b[74Gat\u001b[77Gkey\u001b[81Gmoments\u001b[39m\r\r\n\u001b[38;5;246m/agents\u001b[38GManage\u001b[45Gagent\u001b[51Gconfigurations\u001b[39m\r\r\n\u001b[38;5;246m/autofix-pr\u001b[38GMonitor\u001b[46Gand\u001b[50Gautofix\u001b[58Gany\u001b[62Gissues\u001b[69Gwith\u001b[74Gthe\u001b[78Gcurrent\u001b[86GPR\u001b[39m\r\r\n\u001b[38;5;246m/background\u001b[38GSend\u001b[43Gthis\u001b[48Gsession\u001b[56Gto\u001b[59Gthe\u001b[63Gbackground\u001b[74Gand\u001b[78Gfree\u001b[83Gthe\u001b[87Gterminal\u001b[39m\r\r\n\u001b[38;5;246m/branch\u001b[38GCreate\u001b[45Ga\u001b[47Gbranch\u001b[54Gof\u001b[57Gthe\u001b[61Gcurrent\u001b[69Gconversation\u001b[82Gat\u001b[85Gthis\u001b[90Gpoint\u001b[39m\r\r\n\u001b[38;5;246m/btw\u001b[38GAsk\u001b[42Ga\u001b[44Gquick\u001b[50Gside\u001b[55Gquestion\u001b[64Gwithout\u001b[72Ginterrupting\u001b[85Gthe\u001b[89Gmain\u001b[94Gconversation\u001b[39m\r\r\n\u001b[38;5;246m/chrome\u001b[38GOpen\u001b[43GClaude\u001b[50Gin\u001b[53GChrome\u001b[60G(beta)\u001b[67Gsettings\u001b[39m\r\r\n\u001b[38;5;246m/clear\u001b[38GStart\u001b[44Ga\u001b[46Gnew\u001b