[418.1331, "o", "\u001b[?25l\u001b[2D\u001b[5B\r\u001b[28C\u001b[16A─\u001b[38G┬\u001b[41G─\u001b[49G┬\u001b[60G─\u001b[70G┬\u001b[163G┐\u001b[K\r\u001b[15C\u001b[1B    Flow\u001b[25GID\u001b[29G \u001b[33G    \u001b[38G│\u001b[41G Type\u001b[48G │    \u001b[57GSource\u001b[70G│\u001b[109G     Covers\u001b[163G│\u001b[K\r\u001b[28C\u001b[1B─\u001b[38G┼\u001b[41G─\u001b[49G┼\u001b[60G─\u001b[70G┼\u001b[163G┤\u001b[K\r\u001b[28C\u001b[1B \u001b[31G   \u001b[38G│\u001b[40GNew      │\u001b[51GAdapted\u001b[59Gfrom  \u001b[66G    │ CSV fl\u001b[79Gt-column anonymization — generate CSV with shell,\u001b[129Ganonymize \u001b[38;5;153mname\u001b[39m+\u001b[38;5;153memail\u001b[39m, verify    \u001b[163G│\u001b[K\r\u001b[28C\u001b[1B \u001b[31G       │\u001b[40Gfeature  │ \u001b[38;5;153m@Example\u001b[60G\u001b[39m1\u001b[62G       \u001b[70G│ \u001b[38;5;153mage\u001b[39m/\u001b[38;5;153mcity\u001b[81G\u001b[39mpass through\u001b[94Gunchanged,\u001b[105G\u001b[38;5;153mcount=3\u001b[163G\u001b[39m│\u001b[K\r\u001b[28C\u001b[1B─\u001b[38G┼\u001b[41G─\u001b[49G┼\u001b[60G─\u001b[70G┼\u001b[163G┤\u001b[K\r\u001b[28C\u001b[1B \u001b[31G   \u001b[38G│\u001b[40GNew      │\u001b[51GAdapted\u001b[59Gfrom   \u001b[67G   │ JSON nested-field anonymization — generate NDJSON with shell,\u001b[134Ganonymize\u001b[163G│\u001b[K\r\u001b[28C\u001b[1B \u001b[31G       │\u001b[40Gfeature  │ \u001b[38;5;153m@Example\u001b[60G\u001b[39m2\u001b[62G        │ \u001b[38;5;153muser.profile.fullName\u001b[39m+\u001b[38;5;153muser.profile.email\u001b[39m,\u001b[114Gverify\u001b[121G\u001b[38;5;153mid\u001b[39m passes through,\u001b[140G\u001b[38;5;153mcount=3\u001b[163G\u001b[39m│\u001b[K\r\u001b[2C\u001b[1B├\u001b[9G┼\u001b[29G─\u001b[38G┼\u001b[41G─\u001b[49G┼\u001b[60G─\u001b[70G┼\u001b[163G┤\u001b[K\r\u001b[2C\u001b[1B│\u001b[5G3\u001b[9G│\u001b[11G\u001b[38;5;153mqa_anonymize_superhero_csv\u001b[38G\u001b[39m│\u001b[40GNew\u001b[49G│\u001b[51GVerbatim\u001b[60G\u001b[38;5;153m@Example\u001b[70G\