[417.196712, "o", "\u001b[?25l\u001b[2D\u001b[5B\r\u001b[27C\u001b[13A─┬\u001b[60G┬\u001b[63G─\r\u001b[14C\u001b[1B Flow ID\u001b[28G │\u001b[48GSource \u001b[60G│\u001b[63G \u001b[109GCovers  \r\u001b[27C\u001b[1B─┼\u001b[60G┼\u001b[63G─\r\u001b[27C\u001b[1B │ New\u001b[60G│\u001b[62GCSV flat-column a\u001b[80Gonymization — generate CSV with s\u001b[114Gell, anonymize \u001b[38;5;153mname\u001b[39m+\u001b[38;5;153memail\u001b[39m, verify \u001b[38;5;153mage\u001b[39m/\u001b[38;5;153mcity\u001b[39m pass\r\u001b[27C\u001b[1B │ feature\u001b[60G│\u001b[62Gthrough\u001b[70Gunchanged, \u001b[38;5;153mcount=3\u001b[89G\u001b[39m       \r\u001b[2C\u001b[1B├\u001b[9G┼\u001b[28G─┼\u001b[41G┼\u001b[60G┼\u001b[63G─\u001b[164G┤\r\u001b[2C\u001b[1B│\u001b[5G2\u001b[9G│\u001b[11G\u001b[38;5;153mqa_anonymize_json\u001b[29G\u001b[39m│\u001b[31GNew\u001b[41G│\u001b[43GAdapted\u001b[51Gfrom\u001b[60G│\u001b[62GJSON\u001b[67Gnested-field\u001b[80Ganonymization\u001b[94G—\u001b[96Ggenerate\u001b[105GNDJSON\u001b[112Gwith\u001b[117Gshell,\u001b[124Ganonymize\u001b[164G│\r\u001b[1B  │     │                   │ feature   │ \u001b[38;5;153m@Example\u001b[39m 2       │ \u001b[38;5;153muser.profile.fullName\u001b[39m+\u001b[38;5;153muser.profile.email\u001b[39m, verify \u001b[38;5;153mid\u001b[39m passes through, \u001b[38;5;153mcount=3\u001b[39m                           │\u001b[K\r\u001b[1B  └─────┴───────────────────┴───────────┴──────────────────┴───────────────────────────────────────────────────────────────────────────────────────────────────────┘\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;244m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[38;5;246m❯ \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;244m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────