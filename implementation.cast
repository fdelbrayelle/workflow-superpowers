[413.630686, "o", "\u001b[?25l\u001b[2D\u001b[5B\r\u001b[10A \u001b[3G\u001b[38;5;246mSearched for \u001b[1m1\u001b[22m pattern (ctrl+o to expand)\u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;231m●\u001b[3G\u001b[39mHere is the QA plan for issue #53 / PR #55:\u001b[K\r\u001b[2B  ---\u001b[K\r\u001b[1B\u001b[K\r\u001b[2B\u001b[38;5;246m❯ \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;244m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[38;5;74mSonnet 4.6\u001b[38;5;245m | 📁plugin-datagen | 🔀feat/anonymize-task  | \u001b[38;5;74m██▄\u001b[38;5;238m░░░░░░░\u001b[38;5;246m \u001b[38;5;245m25% of 200k tokens\u001b[39m\r\r\n\u001b[3G\u001b[38;5;246m💬\u001b[6GBase\u001b[11Gdirectory\u001b[21Gfor\u001b[25Gthis\u001b[30Gskill:\u001b[37G/home/francois/dev/plugin-datagen/.claude/skills/k...\u001b[39m\r\r\n\u001b[3G\u001b[38;5;211m⏵⏵\u001b[6Gbypass\u001b[13Gpermissions\u001b[25Gon\u001b[38;5;246m (shift+tab\u001b[39Gto\u001b[42Gcycle)\u001b[49G·\u001b[51GPR\u001b[54G\u001b]8;id=1cqzmc7;https://github.com/kestra-io/plugin-datagen/pull/55\u0007\u001b[38;5;220m\u001b[4m#55\u001b[24m\u001b[39m\u001b]8;;\u0007\r\r\n\u001b[2C\u001b[5A\u001b[?25h"]
[414.055, "o", "\u001b[?25l\u001b[2D\u001b[5B\r\u001b[2C\u001b[7A\u001b[1mQA Plan — \u001b[38;5;153mAnonymize\u001b[39m task (Kestra EE)\r\u001b[1B\u001b[22m\u001b[K\r\u001b[1B  \u001b[1mEdition:\u001b[12G\u001b[22mKestra\u001b[19GEE\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;244m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[38;5;246m❯ \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;244m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;74mSonnet\u001b[10G4.6\u001b[38;5;245m |\u001b[16G📁plugin-datagen\u001b[33G|\u001b[35G🔀feat/anonymize-task\u001b[58G|\u001b[60G\u001b[38;5;74m██▄\u001b[38;5;238m░░░░░░░\u001b[38;5;246m \u001b[38;5;245m25%\u001b[75Gof\u001b[78G200k\u001b[83Gtokens\u001b[39m\r\r\n\u001b[3G\u001b[38;5;246m💬\u001b[6GBase\u001b[11Gdirectory\u001b[21Gfor\u001b[25Gthis\u001b[30Gskill:\u001b[37G/home/francois/dev/plugin-datagen/.claude/skills/k...\u001b[39m\r\r\n\u001b[3G\u001b[38;5;211m⏵⏵\u001b[6Gbypass\u001b[13Gpermissions\u001b[25Gon\u001b[38;5;246m (shift+tab\u001b[39Gto\u001b[42Gcycle)\u001b[49G·\u001b[51GPR\u001b[54G\u001b]8;id=1cqzmc7;https://github.com/kestra-io/plugin-datagen/pull/55\u0007\u001b[38;5;220m\u001b[4m#55\u001b[24m\u001b[39m\u001b]8;;\u0007\r\r\n\u001b[2C\u001b[5A\u001b[?25h"]
[414.502551, "o", "\u001b[?25l\u001b[2D\u001b[5B\r\u001b[2C\u001b[7A\u001b[1mPR:\u001b[7G\u001b]8;id=1cqzmc7;https://github.com/kestra-io/plugin-datagen/pull/55\u0007\u001b[22m\u001b[94mhttps://github.com/kestra-io/plugin-datagen/pull/55\u001b]8;;\u0007\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B  \u001b[1mFlows to test\r\u001b[1B\u001b[22m\u001b[K\r\u001b[1B\u001b[38;5;244m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[38;5;246m❯ \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;244m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;74mSonnet\u001b[10G4.6\u001b[38;5;245m |\u001b[16G📁plugin-datagen\u001b[33G|\u001b[35G🔀feat/anonymize-task\u001b[58G|\u001b[60G\u001b[38;5;74m██▄\u001b[38;5;238m░░░░░░░\u001b[38;5;246m \u001b[38;5;245m25%\u001b[75Gof\u001b[78G200k\u001b[83Gtokens\u001b[39m\r\r\n\u001b[3G\u001b[38;5;246m💬\u001b[6GBase\u001b[11Gdirectory\u001b[21Gfor\u001b[25Gthis\u001b[30Gskill:\u001b[37G/home/francois/dev/plugin-datagen/.claude/skills/k...\u001b[39m\r\r\n\u001b[3G\u001b[38;5;211m⏵⏵\u001b[6Gbypass\u001b[13Gpermissions\u001b[25Gon\u001b[38;5;246m (shift+tab\u001b[39Gto\u001b[42Gcycle)\u001b[49G·\u001b[51GPR\u001b[54G\u001b]8;id=1cqzmc7;https://github.com/kestra-io/plugin-datagen/pull/55\u0007\u001b[38;5;220m\u001b[4m#55\u001b[24m\u001b[39m\u001b]8;;\u0007\r\r\n\u001b[2C\u001b[5A\u001b[?25h"]
[414.97075, "o", "\u001b[?25l\u001b[2D\u001b[5B\r\u001b[6A  ┌─────┬─────────┬──────┬────────┬────────┐\u001b[K\r\u001b[1B  │\u001b[6G#\u001b[9G│\u001b[11GFlow\u001b[16GID\u001b[19G│\u001b[21GType\u001b[26G│\u001b[28GSource\u001b[35G│\u001b[37GCovers\u001b[44G│\r\u001b[1B  ├─────┼─────────┼──────┼────────┼────────┤\u001b[K\r\u001b[2C\u001b[1B└─────┴─────────┴──────┴────────┴────────┘\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;244m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;5;246m❯ \u001b[39m\r\r\n\u001b[38;5;244m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;74mSonnet\u001b[10G4.6\u001b[38;5;245m |\u001b[16G📁plugin-datagen\u001b[33G|\u001b[35G🔀feat/anonymize-task\u001b[58G|\u001b[60G\u001b[38;5;74m██▄\u001b[38;5;238m░░░░░░░\u001b[38;5;246m \u001b[38;5;245m25%\u001b[75Gof\u001b[78G200k\u001b[83Gtokens\u001b[39m\r\r\n\u001b[3G\u001b[38;5;246m💬\u001b[6GBase\u001b[11Gdirectory\u001b[21Gfor\u001b[25Gthis\u001b[30Gskill:\u001b[37G/home/francois/dev/plugin-datagen/.claude/skills/k...\u001b[39m\r\r\n\u001b[3G\u001b[38;5;211m⏵⏵\u001b[6Gbypass\u001b[13Gpermissions\u001b[25Gon\u001b[38;5;246m (shift+tab\u001b[39Gto\u001b[42Gcycle)\u001b[49G·\u001b[51GPR\u001b[54G\u001b]8;id=1cqzmc7;https://github.com/kestra-io/plugin-datagen/pull/55\u0007\u001b[38;5;220m\u001b[4m#55\u001b[24m\u001b[39m\u001b]8;;\u0007\r\r\n\u001b[2C\u001b[5A\u001b[?25h"]
[416.211621, "o", "\u001b[?25l\u001b[2D\u001b[5B\r\u001b[18C\u001b[11A─\u001b[26G─\u001b[28G┬\u001b[35G─\u001b[41G┬\u001b[44G───────────────────┬────────────────────────────────────────────────────────────────────────────────────────────────────┐\r\u001b[10C\u001b[1B    Flow ID   \u001b[26G \u001b[28G│    Type    │ \u001b[44G \u001b[49GSource\u001b[63G│\u001b[111GCovers\u001b[164G│\r\u001b[18C\u001b[1B─\u001b[26G─\u001b[28G┼\u001b[35G─\u001b[41G┼\u001b[44G───────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ 1   │ \u001b[38;5;153mqa_anonymize_csv\u001b[39m │ New        │ Adapted\u001b[51Gfrom\u001b[63G│\u001b[65GCSV\u001b[69Gflat-column\u001b[81Ganonymization\u001b[95G—\u001b[97Ggenerate\u001b[106GCSV\u001b[110Gwith\u001b[115Gshell,\u001b[122Ganonymize\u001b[132G\u001b[38;5;153mname\u001b[39m+\u001b[38;5;153memail\u001b[39m,\u001b[144Gverify\u001b[151G\u001b[38;5;153mage\u001b[39m/\u001b[38;5;153mcity\u001b[164G\u001b[39m│\r\u001b[2C\u001b[1B│\u001b[9G│\u001b[28G│\u001b[30Gfeature\u001b[41G│\u001b[43G\u001b[38;5;153m@Example\u001b[52G\u001b[39m1\u001b[63G│\u001b[65Gpass\u001b[70Gthrough\u001b[78Gunchanged,\u001b[89G\u001b[38;5;153mcount=3\u001b[164G\u001b[39m│\r\u001b[1B  └─────┴──────────────────┴────────────┴─────────────────────┴────────────────────────────────────────────────────────────────────────────────────────────────────┘\u001b[K\r\u001b[1B\u001b[K\r\u001b[2B\u001b[38;5;246m❯ \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;244m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[38;5;74mSonnet 4.6\u001b[38;5;245m | 📁plugin-datagen | 🔀feat/anonymize-task  | \u001b[38;5;74m██▄\u001b[38;5;238m░░░░░░░\u001b[38;5;246m \u001b[38;5;245m25% of 200k tokens\u001b[39m\r\r\n\u001b[3G\u001b[38;5;246m💬\u001b[6GBase\u001b[11Gdirectory\u001b[21Gfor\u001